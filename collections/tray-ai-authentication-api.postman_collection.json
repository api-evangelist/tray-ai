          "id": "2872de71-956b-4e24-9896-5f6490d998d2",
          "name": "Tray.ai Create User Token (Authorize)",
          "request": {
            "name": "Tray.ai Create User Token (Authorize)",
            "description": {
              "content": "Generates a user access token from a master token for a specific user. The returned token is used as a Bearer token for user-scoped API calls such as managing solution instances and authentications. Requires a master token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "graphql"
              ],
              "hash": "authorize",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"variables\": \"<object>\",\n  \"operationName\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
