                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"query\": \"mutation {\\n  authorize(input: {\\n    userId: \\\"user-uuid-here\\\"\\n  }) {\\n    accessToken\\n  }\\n}\"\n}",
